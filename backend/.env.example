# Required for backend startup and the features that use them
MONGO_URI=mongodb://username:password@localhost:27017/eduflex
JWT_SECRET=replace-with-a-long-random-secret
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-cloud-api-key
CLOUD_API_SECRET=your-cloud-api-secret
PAYSTACK_SECRET_KEY=your-paystack-secret-key
MAIL_USER=you@example.com
MAIL_PASS=your-mail-app-password

# Required in production; validate as HTTP or HTTPS URLs when provided
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional settings
PORT=5000
SALT_ROUNDS=10
NODE_ENV=development
FOLDER_NAME=eduflex
